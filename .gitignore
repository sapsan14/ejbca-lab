*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.*
.terraform/
.terraform.lock.hcl
*.tfplan
tfplan
terraform.tfstate.d/

# EJBCA installation files
*.zip
ejbca_*.zip
ejbca_ee_*.zip
ejbca_ce_*.zip
wildfly-*.zip
wildfly-*.tar.gz

# Python cache files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

